{
  "name": "contextweft-monorepo",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "description": "Portable, permission-aware context infrastructure for AI agents.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:performance && pnpm build",
    "clean": "pnpm -r --if-present clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "bench": "pnpm -r --if-present bench",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.9.0",
    "tinybench": "6.1.4",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sqlite-vec"
    ]
  }
}
