{
  "name": "contextweft-monorepo",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "description": "Portable, permission-aware context infrastructure for AI agents.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:performance && pnpm build && pnpm security:audit",
    "clean": "pnpm -r --if-present clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "security:audit": "pnpm audit --prod --audit-level high --registry=https://registry.npmjs.org",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "bench": "pnpm -r --if-present bench",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.2",
    "tinybench": "6.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sqlite-vec"
    ],
    "overrides": {
      "drizzle-orm@<0.45.2": "0.45.2",
      "undici@<6.27.0": "6.28.0"
    }
  }
}
